  },
  "avenue": {
   "width_tiles": 4,
   "cross_section_units": "6 sidewalk | 10 lane, 2 dash, 10 lane | 2 yellow, 4, 2 yellow | 10 lane, 2 dash, 10 lane | 6 sidewalk",
   "notes": "four lanes and a double yellow line"
  }
 },
